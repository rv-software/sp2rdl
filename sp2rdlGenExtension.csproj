<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows8.0</TargetFramework>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.6.0" />
    <PackageReference Include="System.Data.SqlClient" Version="4.9.0" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="17.14.40608" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Build" Version="17.14.40608" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\SkeletonTemplate.rdl" />
    <EmbeddedResource Include="README.md" LogicalName="sp2rdlGenExtension.Help.README.md" />
    <EmbeddedResource Include="docs\INSTALLATION.md" LogicalName="sp2rdlGenExtension.Help.docs.INSTALLATION.md" />
    <EmbeddedResource Include="docs\REPORT_DEVELOPER_QUICK_GUIDE.md" LogicalName="sp2rdlGenExtension.Help.docs.REPORT_DEVELOPER_QUICK_GUIDE.md" />
    <EmbeddedResource Include="docs\TECHNICAL_DOCUMENTATION.md" LogicalName="sp2rdlGenExtension.Help.docs.TECHNICAL_DOCUMENTATION.md" />
    <EmbeddedResource Include="Database\Reporting_Core_Model.sql" LogicalName="sp2rdlGenExtension.Database.Reporting_Core_Model.sql" />
    <EmbeddedResource Include="config\report-validators.json" LogicalName="sp2rdlGenExtension.Config.report-validators.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="README.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="docs\*.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Database\*.sql" CopyToOutputDirectory="Always" />
    <Content Include="config\*.json" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <Target Name="UseWindowsSqlClientRuntimeAssembly" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)runtimes\win\lib\net8.0\System.Data.SqlClient.dll" DestinationFiles="$(OutputPath)System.Data.SqlClient.dll" Condition="Exists('$(OutputPath)runtimes\win\lib\net8.0\System.Data.SqlClient.dll')" />
    <Copy SourceFiles="$(OutputPath)runtimes\win-x64\native\sni.dll" DestinationFiles="$(OutputPath)sni.dll" Condition="Exists('$(OutputPath)runtimes\win-x64\native\sni.dll')" />
  </Target>

  <Target Name="PatchVsixSqlClientRuntimeAssembly" AfterTargets="CreateVsixContainer">
    <Message Importance="High" Text="Replacing SQL Client runtime assemblies in VSIX." />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Build\PatchVsixSqlClient.ps1&quot; -VsixPath &quot;$(TargetVsixContainer)&quot; -RuntimeAssemblyPath &quot;$(OutputPath)runtimes\win\lib\net8.0\System.Data.SqlClient.dll&quot; -SniAssemblyPath &quot;$(OutputPath)runtimes\win-x64\native\sni.dll&quot;" Condition="Exists('$(TargetVsixContainer)') And Exists('$(OutputPath)runtimes\win\lib\net8.0\System.Data.SqlClient.dll') And Exists('$(OutputPath)runtimes\win-x64\native\sni.dll')" />
  </Target>

  <Target Name="CopyInstallGuideNextToVsix" AfterTargets="CreateVsixContainer">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\docs\INSTALLATION.md" DestinationFiles="$(OutputPath)install.md" Condition="Exists('$(MSBuildProjectDirectory)\docs\INSTALLATION.md')" />
  </Target>
</Project>
