<Window x:Class="sp2rdlGenExtension.Dialogs.ImportReportParametersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Load params from report"
        Width="900"
        Height="620"
        MinWidth="760"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DialogBackgroundBrush}"
        Foreground="{DynamicResource DialogPrimaryTextBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Load params from existing report"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource DialogPrimaryTextBrush}"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Report version:" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1"
                      x:Name="CmbReportVersions"
                      DisplayMemberPath="DisplayName"
                      SelectedValuePath="VersionId"
                      Height="32"
                      SelectionChanged="ReportVersions_SelectionChanged"/>
            <Button Grid.Column="3"
                    Content="Refresh"
                    Height="32"
                    Background="{DynamicResource DialogButtonBackgroundBrush}"
                    Click="RefreshButton_Click"/>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Button Content="Select all"
                        Width="90"
                        Height="30"
                        Margin="0,0,8,0"
                        Background="{DynamicResource DialogButtonBackgroundBrush}"
                        Click="SelectAllButton_Click"/>
                <Button Content="Select none"
                        Width="90"
                        Height="30"
                        Margin="0,0,16,0"
                        Background="{DynamicResource DialogButtonBackgroundBrush}"
                        Click="SelectNoneButton_Click"/>
                <CheckBox x:Name="ChkUpdateExisting"
                          Content="Update existing parameters"
                          VerticalAlignment="Center"
                          ToolTip="When checked, selected rows with the same name update existing report parameters. Otherwise existing rows are left unchanged."/>
            </StackPanel>

            <DataGrid Grid.Row="2"
                      x:Name="GridParameters"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="False">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Use" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="54"/>
                    <DataGridTextColumn Header="Ordinal" Binding="{Binding CreationOrder}" IsReadOnly="True" Width="70"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="150"/>
                    <DataGridTextColumn Header="Prompt" Binding="{Binding Label}" IsReadOnly="True" Width="180"/>
                    <DataGridTextColumn Header="Control" Binding="{Binding ComponentTypeName}" IsReadOnly="True" Width="110"/>
                    <DataGridTextColumn Header="Entity key" Binding="{Binding EntityKey}" IsReadOnly="True" Width="160"/>
                    <DataGridTextColumn Header="Display template" Binding="{Binding DisplayFieldTemplate}" IsReadOnly="True" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <TextBlock Grid.Row="6"
                   x:Name="TxtStatus"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource DialogSecondaryTextBrush}"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Import"
                    Width="90"
                    Height="32"
                    Margin="0,0,8,0"
                    Background="{DynamicResource DialogButtonBackgroundBrush}"
                    Click="ImportButton_Click"/>
            <Button Content="Cancel"
                    Width="90"
                    Height="32"
                    Background="{DynamicResource DialogCancelButtonBackgroundBrush}"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
