<Window x:Class="sp2rdlGenExtension.Dialogs.ParameterValidatorsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Runtime settings"
        Width="860"
        MinWidth="720"
        Height="520"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource DialogBackgroundBrush}">

    <Window.Resources>
        <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="DialogPrimaryTextBrush" Color="#D4D4D4"/>
        <SolidColorBrush x:Key="DialogSecondaryTextBrush" Color="#9AA0A6"/>
        <SolidColorBrush x:Key="DialogButtonBackgroundBrush" Color="#3E3E42"/>
        <SolidColorBrush x:Key="DialogButtonTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DialogCancelButtonBackgroundBrush" Color="#4A4A4F"/>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource DialogButtonTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TxtTitle" Text="Runtime settings" Foreground="{DynamicResource DialogPrimaryTextBrush}" FontSize="18" FontWeight="Bold"/>
            <TextBlock x:Name="TxtHint" Text="" Foreground="{DynamicResource DialogSecondaryTextBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <DataGrid Grid.Row="2"
                  x:Name="GridValidators"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  Background="#F4F4F4"
                  Foreground="#000000"
                  RowBackground="#FFFFFF"
                  AlternatingRowBackground="#EEEEEE"
                  GridLinesVisibility="All"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Use" Binding="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="54"/>
                <DataGridTextColumn Header="Code" Binding="{Binding Code}" IsReadOnly="True" Width="115"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="150"/>
                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" IsReadOnly="True" Width="90"/>
                <DataGridTextColumn Header="Type" Binding="{Binding ValueType}" IsReadOnly="True" Width="80"/>
                <DataGridTextColumn Header="Value" Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                <DataGridTextColumn Header="Allowed" Binding="{Binding AllowedValuesText}" IsReadOnly="True" Width="150"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" IsReadOnly="True" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Background="#27AE60" Foreground="White" Style="{StaticResource ActionBtn}" Width="90" Height="34" Margin="0,0,8,0" Click="OkButton_Click"/>
                <Button Content="Cancel" Background="{DynamicResource DialogCancelButtonBackgroundBrush}" Style="{StaticResource ActionBtn}" Width="90" Height="34" Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
