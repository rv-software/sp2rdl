<Window x:Class="sp2rdlGenExtension.Dialogs.ReadmeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SP to RDL Generator Help"
        Width="980"
        Height="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DialogBackgroundBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="TxtDocument"
                 FontFamily="Consolas"
                 FontSize="13"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Background="{DynamicResource DialogFieldBackgroundBrush}"
                 Foreground="{DynamicResource DialogPrimaryTextBrush}"
                 BorderBrush="{DynamicResource DialogBorderBrush}"/>

        <Button Grid.Row="2"
                Content="Close"
                Width="90"
                Height="34"
                HorizontalAlignment="Right"
                Background="{DynamicResource DialogCancelButtonBackgroundBrush}"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
