<Window x:Class="sp2rdlGenExtension.Dialogs.ReportSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generate RDL"
        Width="1280"
        MinWidth="1100"
        Height="820"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource DialogBackgroundBrush}">

    <Window.Resources>
        <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="DialogPanelBrush" Color="#252526"/>
        <SolidColorBrush x:Key="DialogPrimaryTextBrush" Color="#D4D4D4"/>
        <SolidColorBrush x:Key="DialogSecondaryTextBrush" Color="#9AA0A6"/>
        <SolidColorBrush x:Key="DialogFieldBackgroundBrush" Color="#3C3C3C"/>
        <SolidColorBrush x:Key="DialogFieldTextBrush" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="DialogBorderBrush" Color="#3F3F46"/>
        <SolidColorBrush x:Key="DialogButtonBackgroundBrush" Color="#3E3E42"/>
        <SolidColorBrush x:Key="DialogButtonTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DialogCancelButtonBackgroundBrush" Color="#4A4A4F"/>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DialogSecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource DialogFieldBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogFieldTextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource DialogFieldTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource DialogFieldBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogFieldTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogBorderBrush}"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Height" Value="34"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource DialogButtonTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ReadableGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="#F4F4F4"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#EEEEEE"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Background" Value="#DCDCDC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ReadableGridTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CaretBrush" Value="#000000"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Generate RDL" Foreground="{DynamicResource DialogPrimaryTextBrush}" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Configure the report model, datasets, parameters, header/footer and output file."
                       Margin="0,6,0,0"
                       Foreground="{DynamicResource DialogSecondaryTextBrush}"
                       FontSize="12"/>
        </StackPanel>

        <TabControl Grid.Row="2" x:Name="MainTabs" Background="{DynamicResource DialogPanelBrush}" BorderBrush="{DynamicResource DialogBorderBrush}" Foreground="{DynamicResource DialogPrimaryTextBrush}">
            <TabItem Header="General">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Style="{StaticResource LabelText}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtReportName" Style="{StaticResource FieldBox}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Author:" Style="{StaticResource LabelText}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtAuthor" Style="{StaticResource FieldBox}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Description:" Style="{StaticResource LabelText}"/>
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtDescription" Style="{StaticResource FieldBox}" Height="90" AcceptsReturn="True" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Report title:" Style="{StaticResource LabelText}"/>
                    <TextBox Grid.Row="6" Grid.Column="1" x:Name="TxtReportTitle" Style="{StaticResource FieldBox}"/>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Title options:" Style="{StaticResource LabelText}"/>
                    <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal">
                        <CheckBox x:Name="ChkReportTitleEnabled" Content="Generate title band" Foreground="{DynamicResource DialogPrimaryTextBrush}" IsChecked="True" Margin="0,0,18,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Purpose:" Style="{StaticResource LabelText}"/>
                    <ComboBox Grid.Row="10" Grid.Column="1" x:Name="CmbReportPurpose" Style="{StaticResource FieldCombo}" Width="230" HorizontalAlignment="Left" SelectedIndex="0">
                        <ComboBoxItem Content="Main report" Tag="MainReport"/>
                        <ComboBoxItem Content="Memorandum subreport" Tag="MemorandumSubreport"/>
                        <ComboBoxItem Content="Report summary subreport" Tag="ReportSummarySubreport"/>
                    </ComboBox>

                    <TextBlock Grid.Row="12" Grid.Column="0" Text="Output mode:" Style="{StaticResource LabelText}"/>
                    <ComboBox Grid.Row="12" Grid.Column="1" x:Name="CmbOutputMode" Style="{StaticResource FieldCombo}" Width="230" HorizontalAlignment="Left" SelectedIndex="0" Margin="0,0,0,10" Grid.RowSpan="2">
                        <ComboBoxItem Content="RDL" Tag="Rdl"/>
                        <ComboBoxItem Content="RDLC" Tag="Rdlc"/>
                    </ComboBox>

                    <TextBlock Grid.Row="14" Grid.Column="0" Text="Page:" Style="{StaticResource LabelText}"/>
                    <WrapPanel Grid.Row="14" Grid.Column="1" VerticalAlignment="Center">
                        <ComboBox x:Name="CmbPageSize" Style="{StaticResource FieldCombo}" Width="90" SelectedIndex="0" Margin="0,0,8,0">
                            <ComboBoxItem Content="A4" Tag="A4"/>
                            <ComboBoxItem Content="A3" Tag="A3"/>
                            <ComboBoxItem Content="Letter" Tag="Letter"/>
                            <ComboBoxItem Content="Legal" Tag="Legal"/>
                        </ComboBox>
                        <ComboBox x:Name="CmbPageOrientation" Style="{StaticResource FieldCombo}" Width="132" SelectedIndex="0" Margin="0,0,8,0">
                            <ComboBoxItem Content="Portrait" Tag="Portrait"/>
                            <ComboBoxItem Content="Landscape" Tag="Landscape"/>
                        </ComboBox>
                        <TextBlock Text="Margins cm:" Style="{StaticResource LabelText}" Margin="0,0,8,0"/>
                        <TextBlock Text="T" Style="{StaticResource LabelText}" Margin="0,0,3,0" ToolTip="Top margin"/>
                        <TextBox x:Name="TxtMarginTop" Style="{StaticResource FieldBox}" Width="52" Text="1" Margin="0,0,8,0" ToolTip="Top margin"/>
                        <TextBlock Text="L" Style="{StaticResource LabelText}" Margin="0,0,3,0" ToolTip="Left margin"/>
                        <TextBox x:Name="TxtMarginLeft" Style="{StaticResource FieldBox}" Width="52" Text="1" Margin="0,0,8,0" ToolTip="Left margin"/>
                        <TextBlock Text="B" Style="{StaticResource LabelText}" Margin="0,0,3,0" ToolTip="Bottom margin"/>
                        <TextBox x:Name="TxtMarginBottom" Style="{StaticResource FieldBox}" Width="52" Text="1" Margin="0,0,8,0" ToolTip="Bottom margin"/>
                        <TextBlock Text="R" Style="{StaticResource LabelText}" Margin="0,0,3,0" ToolTip="Right margin"/>
                        <TextBox x:Name="TxtMarginRight" Style="{StaticResource FieldBox}" Width="52" Text="1" ToolTip="Right margin"/>
                    </WrapPanel>

                    <TextBlock Grid.Row="16" Grid.Column="0" Text="Base font:" Style="{StaticResource LabelText}"/>
                    <ComboBox Grid.Row="16" Grid.Column="1" x:Name="CmbBaseFont" Style="{StaticResource FieldCombo}" Width="230" HorizontalAlignment="Left" IsEditable="True" IsTextSearchEnabled="True" Margin="0,0,0,10" Grid.RowSpan="2"/>

                </Grid>
            </TabItem>

            <TabItem Header="Main dataset">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Connection:" Style="{StaticResource LabelText}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtConnectionString" Style="{StaticResource FieldBox}" IsReadOnly="True"/>
                    <Button Grid.Row="0" Grid.Column="3" Content="Connection..." Background="{DynamicResource DialogButtonBackgroundBrush}" Style="{StaticResource ActionBtn}" Click="ConnectionButton_Click"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Source:" Style="{StaticResource LabelText}"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CmbMainDatasetSource" Style="{StaticResource FieldCombo}" Width="210" HorizontalAlignment="Left" SelectedIndex="0" SelectionChanged="MainDatasetSource_Changed">
                        <ComboBoxItem Content="Stored procedure" Tag="StoredProcedure"/>
                        <ComboBoxItem Content="SQL text" Tag="Text"/>
                    </ComboBox>

                    <TextBlock Grid.Row="4" Grid.Column="0" x:Name="LblStoredProcedure" Text="Procedure:" Style="{StaticResource LabelText}"/>
                    <ComboBox Grid.Row="4" Grid.Column="1" x:Name="CmbStoredProcedure" Style="{StaticResource FieldCombo}" DisplayMemberPath="DisplayName" IsEditable="True" IsTextSearchEnabled="True"/>
                    <Button Grid.Row="4" Grid.Column="3" x:Name="BtnLoadProcedures" Content="Refresh" Background="{DynamicResource DialogButtonBackgroundBrush}" Style="{StaticResource ActionBtn}" Click="LoadProceduresButton_Click"/>
                    <Button Grid.Row="4" Grid.Column="3" x:Name="BtnEditMainSql" Content="Edit SQL..." Background="{DynamicResource DialogButtonBackgroundBrush}" Style="{StaticResource ActionBtn}" Click="EditMainSqlButton_Click" Visibility="Collapsed"/>

                    <StackPanel Grid.Row="6" Grid.Column="3">
                        <Button Content="Inspect" Background="{DynamicResource DialogButtonBackgroundBrush}" Style="{StaticResource ActionBtn}" Height="32" Margin="0,0,0,6" Click="InspectProcedureButton_Click"/>
                        <Button Content="Suggest cols" Background="{DynamicResource DialogButtonBackgroundBrush}" Style="{StaticResource ActionBtn}" Height="32" Click="SuggestColumnsButton_Click"/>
                    </StackPanel>
                    <TextBlock Grid.Row="6" Grid.Column="1" x:Name="LblMetadataStatus" Text="" Foreground="#D7BA7D" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>

                    <Grid Grid.Row="8" Grid.ColumnSpan="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" x:Name="LblDatasetParametersHeader" Text="Stored procedure params" Foreground="{DynamicResource DialogPrimaryTextBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" x:Name="LblDatasetColumnsHeader" Text="Stored procedure columns" Foreground="{DynamicResource DialogPrimaryTextBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <DataGrid Grid.Row="1" Grid.Column="0" x:Name="GridParameters" AutoGenerateColumns="True" IsReadOnly="True" Style="{StaticResource ReadableGrid}"/>
                        <GridSplitter Grid.Row="1" Grid.Column="1"
                                      Width="6"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Background="{DynamicResource DialogBorderBrush}"
                                      ShowsPreview="True"/>
                        <DataGrid Grid.Row="1" Grid.Column="2"
                                  x:Name="GridFields"
                                  Style="{StaticResource ReadableGrid}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="False"
                                  CanUserAddRows="True"
                                  CanUserDeleteRows="True"
                                  SelectionUnit="CellOrRowHeader">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Show" Binding="{Binding IncludeInReport, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="58"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EditingElementStyle="{StaticResource ReadableGridTextBox}" Width="*"/>
                                <DataGridTextColumn Header="Default label" Binding="{Binding DefaultLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EditingElementStyle="{StaticResource ReadableGridTextBox}" Width="1.25*"/>
                                <DataGridComboBoxColumn x:Name="ColFieldSqlType" Header="SqlTypeName" SelectedItemBinding="{Binding SqlTypeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="1.1*"/>
                                <DataGridCheckBoxColumn Header="Nullable" Binding="{Binding IsNullable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="0.7*"/>
                                <DataGridTextColumn Header="Ordinal" Binding="{Binding OrdinalPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EditingElementStyle="{StaticResource ReadableGridTextBox}" Width="0.65*"/>
                                <DataGridTextColumn Header="Format" Binding="{Binding Format, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EditingElementStyle="{StaticResource ReadableGridTextBox}" Width="1.05*"/>
                                <DataGridComboBoxColumn x:Name="ColFieldTextAlign" Header="Align" SelectedItemBinding="{Binding TextAlign, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                <DataGridComboBoxColumn x:Name="ColFieldGroupLevel" Header="Group" SelectedValueBinding="{Binding GroupLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Value" DisplayMemberPath="Label" Width="70"/>
                                <DataGridTemplateColumn Header="Aggregate" Width="0.9*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding AllowedAggregates}"
                                                      SelectedItem="{Binding AggregateFunction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Background="White"
                                                      Foreground="#202020"
                                                      BorderBrush="#A6A6A6"
                                                      Padding="3,1"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Report params">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Load from report..."
                                Background="{DynamicResource DialogButtonBackgroundBrush}"
                                Style="{StaticResource ActionBtn}"
                                Width="145"
                                Height="32"
                                Margin="0,0,8,0"
                                ToolTip="Select parameters from an existing Reporting report version and import them into this grid."
                                Click="LoadReportParametersButton_Click"/>
                        <Button Content="Apply definitions"
                                Background="{DynamicResource DialogButtonBackgroundBrush}"
                                Style="{StaticResource ActionBtn}"
                                Width="140"
                                Height="32"
                                ToolTip="Apply matching Reporting.ParameterDefinition defaults to the current report parameters."
                                Click="ApplyParameterDefinitionsButton_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2"
                              x:Name="GridReportParameters"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              CanUserAddRows="True"
                              CanUserDeleteRows="True"
                              Style="{StaticResource ReadableGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ordinal" Binding="{Binding OrdinalNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EditingElementStyle="{StaticResource ReadableGridTextBox}" Width="68"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EditingElementStyle="{StaticResource ReadableGridTextBox}" Width="112"/>
                        <DataGridTextColumn Header="Prompt" Binding="{Binding Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EditingElementStyle="{StaticResource ReadableGridTextBox}" Width="140"/>
                        <DataGridComboBoxColumn x:Name="ColParameterSqlType" Header="SqlType" SelectedItemBinding="{Binding SqlTypeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="112"/>
                        <DataGridComboBoxColumn x:Name="ColParameterControlType" Header="Control" SelectedItemBinding="{Binding ControlType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="94"/>
                        <DataGridCheckBoxColumn Header="Nullable" Binding="{Binding Nullable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="72"/>
                        <DataGridCheckBoxColumn Header="Multi" Binding="{Binding MultiValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="56"/>
                        <DataGridCheckBoxColumn Header="Visible" Binding="{Binding IsVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="62"/>
                        <DataGridTextColumn Header="Entity key" Binding="{Binding EntityKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EditingElementStyle="{StaticResource ReadableGridTextBox}" Width="130"/>
                        <DataGridTextColumn Header="Value template" Binding="{Binding ValueFieldTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EditingElementStyle="{StaticResource ReadableGridTextBox}" Width="140"/>
                        <DataGridTextColumn Header="Display template" Binding="{Binding DisplayFieldTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EditingElementStyle="{StaticResource ReadableGridTextBox}" Width="150"/>
                        <DataGridTemplateColumn Header="Static" Width="66">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="..." ToolTip="Static valid values" Click="EditStaticValuesButton_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#DFF3E4"/>
                                                <Setter Property="Foreground" Value="#145A2A"/>
                                                <Setter Property="BorderBrush" Value="#27AE60"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StaticValidValues.Count}" Value="0">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="Foreground" Value="#202020"/>
                                                        <Setter Property="BorderBrush" Value="#A6A6A6"/>
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Runtime settings" Width="112">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="..." ToolTip="Runtime settings" Click="EditValidatorsButton_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#DFF3E4"/>
                                                <Setter Property="Foreground" Value="#145A2A"/>
                                                <Setter Property="BorderBrush" Value="#27AE60"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RuntimeSettings.Count}" Value="0">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="Foreground" Value="#202020"/>
                                                        <Setter Property="BorderBrush" Value="#A6A6A6"/>
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Format" Binding="{Binding DisplayFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EditingElementStyle="{StaticResource ReadableGridTextBox}" Width="95"/>
                        <DataGridTemplateColumn Header="Depends on" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Click="DependsOnDropDownButton_Click"
                                            HorizontalContentAlignment="Stretch"
                                            Padding="4,2"
                                            Background="White"
                                            BorderBrush="#A6A6A6"
                                            Foreground="#202020">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock Text="▼" DockPanel.Dock="Right" Margin="6,0,0,0"/>
                                            <TextBlock Text="{Binding DependsOnParameterName, TargetNullValue=''}" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Filter path" Binding="{Binding DependencyFilterPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EditingElementStyle="{StaticResource ReadableGridTextBox}" Width="140"/>
                        <DataGridComboBoxColumn x:Name="ColParameterBindToSpParam" Header="Bind to SP param" SelectedValueBinding="{Binding BindToDatasetParameterName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Value" DisplayMemberPath="Label" Width="136"/>
                        <DataGridTemplateColumn Header="Compare to" Width="112">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Click="CompareToDropDownButton_Click"
                                            HorizontalContentAlignment="Stretch"
                                            Padding="4,2"
                                            Background="White"
                                            BorderBrush="#A6A6A6"
                                            Foreground="#202020">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock Text="▼" DockPanel.Dock="Right" Margin="6,0,0,0"/>
                                            <TextBlock Text="{Binding CompareToParameterName, TargetNullValue=''}" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridComboBoxColumn x:Name="ColParameterCompareOperator" Header="Op" SelectedItemBinding="{Binding CompareOperator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="52"/>
                        <DataGridTemplateColumn Header="Default SQL" Width="82">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="..." ToolTip="{Binding DefaultValueSql}" Click="EditDefaultSqlButton_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Lookup SQL" Width="82">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="..." ToolTip="{Binding LookupSql}" Click="EditLookupSqlButton_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Report variables">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Variables SQL:" Style="{StaticResource LabelText}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtReportVariablesSql" Style="{StaticResource FieldBox}" IsReadOnly="True"/>
                    <Button Grid.Row="0" Grid.Column="3" Content="..." Background="{DynamicResource DialogButtonBackgroundBrush}" Style="{StaticResource ActionBtn}" Height="34" Click="EditReportVariablesSqlButton_Click"/>
                    <Button Grid.Row="0" Grid.Column="5" Content="Generate variables" Background="{DynamicResource DialogButtonBackgroundBrush}" Style="{StaticResource ActionBtn}" Height="34" Click="GenerateReportVariablesButton_Click"/>

                    <DataGrid Grid.Row="2" Grid.ColumnSpan="6" x:Name="GridReportVariables"
                              AutoGenerateColumns="False"
                              CanUserAddRows="True"
                              CanUserDeleteRows="True"
                              Style="{StaticResource ReadableGrid}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="72"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="160">
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource ReadableGridTextBox}"/>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Source column" Binding="{Binding SourceColumnName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="160">
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource ReadableGridTextBox}"/>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Static value" Binding="{Binding StaticValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                <DataGridTextColumn.EditingElementStyle>
