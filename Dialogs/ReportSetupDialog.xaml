<Window x:Class="sp2rdlGenExtension.Dialogs.ReportSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generate RDL from Stored Procedure"
        Width="980"
        MinWidth="860"
        Height="760"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#1E1E1E">

    <Window.Resources>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA0A6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Height" Value="34"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ReadableGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="#F4F4F4"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#EEEEEE"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Background" Value="#DCDCDC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ReadableGridTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CaretBrush" Value="#000000"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Generate RDL from Stored Procedure" Foreground="#D4D4D4" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Configure the report model, datasets, parameters, header/footer and output file."
                       Margin="0,6,0,0"
                       Foreground="#9AA0A6"
                       FontSize="12"/>
        </StackPanel>

        <TabControl Grid.Row="2" Background="#252526" BorderBrush="#3F3F46" Foreground="#D4D4D4">
            <TabItem Header="General">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Style="{StaticResource LabelText}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtReportName" Style="{StaticResource FieldBox}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Author:" Style="{StaticResource LabelText}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtAuthor" Style="{StaticResource FieldBox}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Description:" Style="{StaticResource LabelText}"/>
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtDescription" Style="{StaticResource FieldBox}" Height="90" AcceptsReturn="True" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Output mode:" Style="{StaticResource LabelText}"/>
                    <ComboBox Grid.Row="6" Grid.Column="1" x:Name="CmbOutputMode" Style="{StaticResource FieldCombo}" Width="180" HorizontalAlignment="Left" SelectedIndex="0">
                        <ComboBoxItem Content="RDL" Tag="Rdl"/>
                        <ComboBoxItem Content="RDLC" Tag="Rdlc"/>
                    </ComboBox>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Page:" Style="{StaticResource LabelText}"/>
                    <WrapPanel Grid.Row="8" Grid.Column="1" VerticalAlignment="Center">
                        <ComboBox x:Name="CmbPageSize" Style="{StaticResource FieldCombo}" Width="90" SelectedIndex="0" Margin="0,0,8,0">
                            <ComboBoxItem Content="A4" Tag="A4"/>
                            <ComboBoxItem Content="A3" Tag="A3"/>
                            <ComboBoxItem Content="Letter" Tag="Letter"/>
                            <ComboBoxItem Content="Legal" Tag="Legal"/>
                        </ComboBox>
                        <ComboBox x:Name="CmbPageOrientation" Style="{StaticResource FieldCombo}" Width="130" SelectedIndex="0" Margin="0,0,8,0">
                            <ComboBoxItem Content="Portrait" Tag="Portrait"/>
                            <ComboBoxItem Content="Landscape" Tag="Landscape"/>
                        </ComboBox>
                        <TextBlock Text="Margins cm:" Style="{StaticResource LabelText}" Margin="0,0,8,0"/>
                        <TextBox x:Name="TxtMarginLeft" Style="{StaticResource FieldBox}" Width="52" Text="1" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtMarginRight" Style="{StaticResource FieldBox}" Width="52" Text="1" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtMarginTop" Style="{StaticResource FieldBox}" Width="52" Text="1" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtMarginBottom" Style="{StaticResource FieldBox}" Width="52" Text="1"/>
                    </WrapPanel>

                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Base font:" Style="{StaticResource LabelText}"/>
                    <ComboBox Grid.Row="10" Grid.Column="1" x:Name="CmbBaseFont" Style="{StaticResource FieldCombo}" Width="260" HorizontalAlignment="Left" IsEditable="True" IsTextSearchEnabled="True"/>

                </Grid>
            </TabItem>

            <TabItem Header="Main dataset">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Connection:" Style="{StaticResource LabelText}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtConnectionString" Style="{StaticResource FieldBox}" IsReadOnly="True"/>
                    <Button Grid.Row="0" Grid.Column="3" Content="Connection..." Background="#3E3E42" Style="{StaticResource ActionBtn}" Click="ConnectionButton_Click"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Procedure:" Style="{StaticResource LabelText}"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CmbStoredProcedure" Style="{StaticResource FieldCombo}" DisplayMemberPath="DisplayName" IsEditable="True" IsTextSearchEnabled="True"/>
                    <Button Grid.Row="2" Grid.Column="3" Content="Refresh" Background="#3E3E42" Style="{StaticResource ActionBtn}" Click="LoadProceduresButton_Click"/>

                    <StackPanel Grid.Row="4" Grid.Column="3">
                        <Button Content="Inspect" Background="#3E3E42" Style="{StaticResource ActionBtn}" Height="32" Margin="0,0,0,6" Click="InspectProcedureButton_Click"/>
                        <Button Content="Suggest cols" Background="#3E3E42" Style="{StaticResource ActionBtn}" Height="32" Click="SuggestColumnsButton_Click"/>
                    </StackPanel>
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="LblMetadataStatus" Text="" Foreground="#D7BA7D" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>

                    <Grid Grid.Row="6" Grid.ColumnSpan="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid Grid.Column="0" x:Name="GridParameters" AutoGenerateColumns="True" IsReadOnly="True" Style="{StaticResource ReadableGrid}"/>
                        <DataGrid Grid.Column="2"
                                  x:Name="GridFields"
                                  Style="{StaticResource ReadableGrid}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="False"
                                  CanUserAddRows="True"
                                  CanUserDeleteRows="True"
                                  SelectionUnit="CellOrRowHeader">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EditingElementStyle="{StaticResource ReadableGridTextBox}" Width="*"/>
                                <DataGridComboBoxColumn x:Name="ColFieldSqlType" Header="SqlTypeName" SelectedItemBinding="{Binding SqlTypeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                                <DataGridCheckBoxColumn Header="Nullable" Binding="{Binding IsNullable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                <DataGridTextColumn Header="Ordinal" Binding="{Binding OrdinalPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EditingElementStyle="{StaticResource ReadableGridTextBox}" Width="70"/>
                                <DataGridTextColumn Header="Format" Binding="{Binding Format, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EditingElementStyle="{StaticResource ReadableGridTextBox}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Report params">
                <DataGrid x:Name="GridReportParameters"
                          Margin="16"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          CanUserAddRows="True"
                          CanUserDeleteRows="True"
                          Style="{StaticResource ReadableGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ordinal" Binding="{Binding OrdinalNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EditingElementStyle="{StaticResource ReadableGridTextBox}" Width="70"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EditingElementStyle="{StaticResource ReadableGridTextBox}" Width="120"/>
                        <DataGridTextColumn Header="Prompt" Binding="{Binding Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EditingElementStyle="{StaticResource ReadableGridTextBox}" Width="150"/>
                        <DataGridComboBoxColumn x:Name="ColParameterSqlType" Header="SqlType" SelectedItemBinding="{Binding SqlTypeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="125"/>
                        <DataGridComboBoxColumn x:Name="ColParameterControlType" Header="Control" SelectedItemBinding="{Binding ControlType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                        <DataGridCheckBoxColumn Header="Nullable" Binding="{Binding Nullable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                        <DataGridCheckBoxColumn Header="Multi" Binding="{Binding MultiValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                        <DataGridTextColumn Header="Format" Binding="{Binding DisplayFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EditingElementStyle="{StaticResource ReadableGridTextBox}" Width="110"/>
                        <DataGridTemplateColumn Header="Depends on" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Click="DependsOnDropDownButton_Click"
                                            HorizontalContentAlignment="Stretch"
                                            Padding="4,2"
                                            Background="White"
                                            BorderBrush="#A6A6A6"
                                            Foreground="#202020">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock Text="▼" DockPanel.Dock="Right" Margin="6,0,0,0"/>
                                            <TextBlock Text="{Binding DependsOnParameterName, TargetNullValue=''}" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Bind to SP param" Binding="{Binding BindToDatasetParameterName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EditingElementStyle="{StaticResource ReadableGridTextBox}" Width="125"/>
                        <DataGridTemplateColumn Header="Default SQL" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="..." ToolTip="{Binding DefaultValueSql}" Click="EditDefaultSqlButton_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Lookup SQL" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="..." ToolTip="{Binding LookupSql}" Click="EditLookupSqlButton_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Lookups">
                <DataGrid x:Name="GridLookups" Margin="16" AutoGenerateColumns="True" Style="{StaticResource ReadableGrid}"/>
            </TabItem>

            <TabItem Header="Body / Tablix">
                <Grid Margin="16">
                    <TextBlock Text="Body / Tablix setup is planned for Phase 2." Foreground="#9AA0A6" VerticalAlignment="Top"/>
                </Grid>
            </TabItem>

            <TabItem Header="Header / Footer">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Report title:" Style="{StaticResource LabelText}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" x:Name="TxtReportTitle" Style="{StaticResource FieldBox}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Title options:" Style="{StaticResource LabelText}"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal">
                        <CheckBox x:Name="ChkReportTitleEnabled" Content="Generate title band" Foreground="#D4D4D4" IsChecked="True" Margin="0,0,18,0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="ChkTitleInHeader" Content="Show in header after first page" Foreground="#D4D4D4" IsChecked="True" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Company:" Style="{StaticResource LabelText}"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" x:Name="TxtCompanyName" Style="{StaticResource FieldBox}"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Company SQL:" Style="{StaticResource LabelText}"/>
                    <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" x:Name="TxtCompanySql" Style="{StaticResource FieldBox}" Height="58" AcceptsReturn="True" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Company API:" Style="{StaticResource LabelText}"/>
                    <TextBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3" x:Name="TxtCompanyEndpoint" Style="{StaticResource FieldBox}"/>

                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Header right:" Style="{StaticResource LabelText}"/>
                    <TextBox Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="3" x:Name="TxtHeaderRight" Style="{StaticResource FieldBox}"/>

                    <TextBlock Grid.Row="12" Grid.Column="0" Text="Footer left:" Style="{StaticResource LabelText}"/>
                    <TextBox Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="3" x:Name="TxtFooterLeft" Style="{StaticResource FieldBox}"/>

                    <TextBlock Grid.Row="14" Grid.Column="0" Text="Footer logo:" Style="{StaticResource LabelText}"/>
                    <TextBox Grid.Row="14" Grid.Column="1" x:Name="TxtFooterLogo" Style="{StaticResource FieldBox}" Height="34"/>
                    <Button Grid.Row="14" Grid.Column="3" Content="Browse" Background="#3E3E42" Style="{StaticResource ActionBtn}" Height="34" Click="BrowseFooterLogoButton_Click"/>
                </Grid>
            </TabItem>

            <TabItem Header="Output">
                <Grid Margin="16" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Save as:" Style="{StaticResource LabelText}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtOutputPath" Style="{StaticResource FieldBox}" Height="34"/>
                    <Button Grid.Row="0" Grid.Column="3" Content="Browse" Background="#3E3E42" Style="{StaticResource ActionBtn}" Height="34" Click="BrowseOutputButton_Click"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Save state..." Background="#3E3E42" Style="{StaticResource ActionBtn}" Width="120" Height="34" Margin="0,0,8,0" Click="SaveStateButton_Click"/>
                <Button Content="Load state..." Background="#3E3E42" Style="{StaticResource ActionBtn}" Width="120" Height="34" Click="LoadStateButton_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="GenerateButton" Content="Generate" Background="#27AE60" Style="{StaticResource ActionBtn}" Width="100" Height="34" Margin="0,0,8,0" Click="GenerateButton_Click"/>
                <Button Content="Cancel" Background="#4A4A4F" Style="{StaticResource ActionBtn}" Width="90" Height="34" Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
