                            <Button Grid.Row="4" Grid.Column="4" x:Name="BtnLocalizationRegisterReport" Content="Register report" Width="160" Height="30" HorizontalAlignment="Right"
                                    Background="{DynamicResource DialogButtonBackgroundBrush}" Style="{StaticResource ActionBtn}"
