                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                        <CheckBox x:Name="ChkReportSummaryEnabled" Content="Enabled" Foreground="{DynamicResource DialogPrimaryTextBrush}" Margin="0,0,18,0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="ChkReportSummaryTopLine" Content="Top line" Foreground="{DynamicResource DialogPrimaryTextBrush}" IsChecked="True" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Layout mode:" Style="{StaticResource LabelText}"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                        <ComboBox x:Name="CmbReportSummaryLayoutMode" Style="{StaticResource FieldCombo}" Width="160" SelectedIndex="0">
                            <ComboBoxItem Content="Inline" Tag="Inline"/>
                            <ComboBoxItem Content="Subreport" Tag="Subreport"/>
                        </ComboBox>
                        <CheckBox x:Name="ChkReportSummaryFallbackInline" Content="Fallback to inline" Foreground="{DynamicResource DialogPrimaryTextBrush}" IsChecked="True" Margin="18,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Subreport:" Style="{StaticResource LabelText}"/>
                    <Grid Grid.Row="4" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TxtReportSummarySubreport" Style="{StaticResource FieldBox}" Height="34"/>
                        <Button Grid.Column="2" Content="Browse" Background="{DynamicResource DialogButtonBackgroundBrush}" Style="{StaticResource ActionBtn}" Height="34" Click="BrowseReportSummarySubreportButton_Click"/>
                    </Grid>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Server path:" Style="{StaticResource LabelText}"/>
                    <TextBox Grid.Row="6" Grid.Column="1" x:Name="TxtReportSummarySubreportServerPath" Style="{StaticResource FieldBox}" Height="34"/>

                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Height cm:" Style="{StaticResource LabelText}"/>
                    <TextBox Grid.Row="10" Grid.Column="1" x:Name="TxtReportSummaryHeight" Style="{StaticResource FieldBox}" Width="120" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="12" Grid.Column="0" Text="Columns:" Style="{StaticResource LabelText}"/>
                    <GroupBox Grid.Row="12" Grid.Column="1" Header="Report summary columns" Foreground="{DynamicResource DialogPrimaryTextBrush}" Padding="10">
                        <StackPanel Orientation="Vertical">
                            <WrapPanel Margin="0,0,0,10">
                                <Button Content="B" Width="34" Height="28" Margin="0,0,4,0" Background="{DynamicResource DialogButtonBackgroundBrush}" Style="{StaticResource ActionBtn}" Click="ReportSummaryBoldButton_Click"/>
                                <Button Content="I" Width="34" Height="28" Margin="0,0,4,0" Background="{DynamicResource DialogButtonBackgroundBrush}" Style="{StaticResource ActionBtn}" Click="ReportSummaryItalicButton_Click"/>
                                <Button Content="U" Width="34" Height="28" Margin="0,0,10,0" Background="{DynamicResource DialogButtonBackgroundBrush}" Style="{StaticResource ActionBtn}" Click="ReportSummaryUnderlineButton_Click"/>
                                <Button Content="Left" Width="64" Height="28" Margin="0,0,4,0" Background="{DynamicResource DialogButtonBackgroundBrush}" Style="{StaticResource ActionBtn}" Click="ReportSummaryAlignLeftButton_Click"/>
                                <Button Content="Center" Width="76" Height="28" Margin="0,0,4,0" Background="{DynamicResource DialogButtonBackgroundBrush}" Style="{StaticResource ActionBtn}" Click="ReportSummaryAlignCenterButton_Click"/>
                                <Button Content="Right" Width="64" Height="28" Margin="0,0,10,0" Background="{DynamicResource DialogButtonBackgroundBrush}" Style="{StaticResource ActionBtn}" Click="ReportSummaryAlignRightButton_Click"/>
                                <Button Content="Bullet" Width="78" Height="28" Margin="0,0,4,0" Background="{DynamicResource DialogButtonBackgroundBrush}" Style="{StaticResource ActionBtn}" Click="ReportSummaryBulletButton_Click"/>
                                <Button Content="Number" Width="82" Height="28" Margin="0,0,4,0" Background="{DynamicResource DialogButtonBackgroundBrush}" Style="{StaticResource ActionBtn}" Click="ReportSummaryNumberButton_Click"/>
                                <Button Content="Line" Width="64" Height="28" Background="{DynamicResource DialogButtonBackgroundBrush}" Style="{StaticResource ActionBtn}" Click="ReportSummaryLineButton_Click"/>
                            </WrapPanel>
                            <ComboBox x:Name="CmbReportSummaryColumnCount" Style="{StaticResource FieldCombo}" Width="120" HorizontalAlignment="Left" SelectedIndex="0" SelectionChanged="ReportSummaryColumnCount_Changed">
                                <ComboBoxItem Content="1" Tag="1"/>
                                <ComboBoxItem Content="2" Tag="2"/>
                                <ComboBoxItem Content="3" Tag="3"/>
                            </ComboBox>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ColReportSummaryColumn1" Width="*"/>
                                    <ColumnDefinition x:Name="ColReportSummaryColumn2" Width="0"/>
                                    <ColumnDefinition x:Name="ColReportSummaryColumn3" Width="0"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="PanelReportSummaryColumn1" Grid.Column="0" Margin="0,0,8,0">
                                    <StackPanel Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <CheckBox x:Name="ChkReportSummaryColumn1Line" Content="Line above" Foreground="{DynamicResource DialogPrimaryTextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Width %:" Style="{StaticResource LabelText}" Margin="14,0,6,0" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtReportSummaryColumn1WidthPercent" Style="{StaticResource FieldBox}" Width="48" Height="28"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Vertical:" Style="{StaticResource LabelText}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="CmbReportSummaryColumn1VerticalAlign" Style="{StaticResource FieldCombo}" Width="78" Height="28" SelectedIndex="0">
                                                <ComboBoxItem Content="Top" Tag="Top"/>
                                                <ComboBoxItem Content="Middle" Tag="Middle"/>
                                                <ComboBoxItem Content="Bottom" Tag="Bottom"/>
                                            </ComboBox>
                                            <TextBlock Text="Padding:" Style="{StaticResource LabelText}" Margin="12,0,6,0" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtReportSummaryColumn1Padding" Style="{StaticResource FieldBox}" Width="44" Height="28"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="Column 1 template:" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtReportSummaryColumn1Template" Style="{StaticResource FieldBox}" Height="140" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ContextMenuOpening="TemplateTextBox_ContextMenuOpening" GotKeyboardFocus="ReportSummaryTemplate_GotKeyboardFocus"/>
                                </StackPanel>
                                <StackPanel x:Name="PanelReportSummaryColumn2" Grid.Column="1" Margin="8,0,8,0" Visibility="Collapsed">
                                    <StackPanel Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <CheckBox x:Name="ChkReportSummaryColumn2Line" Content="Line above" Foreground="{DynamicResource DialogPrimaryTextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Width %:" Style="{StaticResource LabelText}" Margin="14,0,6,0" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtReportSummaryColumn2WidthPercent" Style="{StaticResource FieldBox}" Width="48" Height="28"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Vertical:" Style="{StaticResource LabelText}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="CmbReportSummaryColumn2VerticalAlign" Style="{StaticResource FieldCombo}" Width="78" Height="28" SelectedIndex="0">
                                                <ComboBoxItem Content="Top" Tag="Top"/>
                                                <ComboBoxItem Content="Middle" Tag="Middle"/>
                                                <ComboBoxItem Content="Bottom" Tag="Bottom"/>
                                            </ComboBox>
                                            <TextBlock Text="Padding:" Style="{StaticResource LabelText}" Margin="12,0,6,0" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtReportSummaryColumn2Padding" Style="{StaticResource FieldBox}" Width="44" Height="28"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="Column 2 template:" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtReportSummaryColumn2Template" Style="{StaticResource FieldBox}" Height="140" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ContextMenuOpening="TemplateTextBox_ContextMenuOpening" GotKeyboardFocus="ReportSummaryTemplate_GotKeyboardFocus"/>
                                </StackPanel>
                                <StackPanel x:Name="PanelReportSummaryColumn3" Grid.Column="2" Margin="8,0,0,0" Visibility="Collapsed">
                                    <StackPanel Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <CheckBox x:Name="ChkReportSummaryColumn3Line" Content="Line above" Foreground="{DynamicResource DialogPrimaryTextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Width %:" Style="{StaticResource LabelText}" Margin="14,0,6,0" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtReportSummaryColumn3WidthPercent" Style="{StaticResource FieldBox}" Width="48" Height="28"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Vertical:" Style="{StaticResource LabelText}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="CmbReportSummaryColumn3VerticalAlign" Style="{StaticResource FieldCombo}" Width="78" Height="28" SelectedIndex="0">
                                                <ComboBoxItem Content="Top" Tag="Top"/>
                                                <ComboBoxItem Content="Middle" Tag="Middle"/>
                                                <ComboBoxItem Content="Bottom" Tag="Bottom"/>
                                            </ComboBox>
                                            <TextBlock Text="Padding:" Style="{StaticResource LabelText}" Margin="12,0,6,0" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtReportSummaryColumn3Padding" Style="{StaticResource FieldBox}" Width="44" Height="28"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="Column 3 template:" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtReportSummaryColumn3Template" Style="{StaticResource FieldBox}" Height="140" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ContextMenuOpening="TemplateTextBox_ContextMenuOpening" GotKeyboardFocus="ReportSummaryTemplate_GotKeyboardFocus"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem x:Name="OutputTab" Header="Output">
                <Grid Margin="16" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Save as:" Style="{StaticResource LabelText}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtOutputPath" Style="{StaticResource FieldBox}" Height="34"/>
                    <Button Grid.Row="0" Grid.Column="3" Content="Browse" Background="{DynamicResource DialogButtonBackgroundBrush}" Style="{StaticResource ActionBtn}" Height="34" Click="BrowseOutputButton_Click"/>

                    <GroupBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Header="Reporting metadata migration" Padding="12" BorderBrush="{DynamicResource DialogBorderBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Reporting connection:" Style="{StaticResource LabelText}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtReportingConnectionString" Style="{StaticResource FieldBox}" Height="34" IsReadOnly="True"/>
                            <Button Grid.Row="0" Grid.Column="3" Content="Connection..." Background="{DynamicResource DialogButtonBackgroundBrush}" Style="{StaticResource ActionBtn}" Height="34" Click="ReportingConnectionButton_Click"/>
                            <Button Grid.Row="0" Grid.Column="5" Content="Test" Background="{DynamicResource DialogButtonBackgroundBrush}" Style="{StaticResource ActionBtn}" Height="34" Click="TestReportingConnectionButton_Click"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Version valid from:" Style="{StaticResource LabelText}"/>
                            <DatePicker Grid.Row="2" Grid.Column="1" x:Name="DpReportingVersionValidFrom" Height="34" HorizontalAlignment="Left" Width="180"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Migration folder:" Style="{StaticResource LabelText}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtReportingMigrationFolder" Style="{StaticResource FieldBox}" Height="34"/>
                            <Button Grid.Row="4" Grid.Column="3" Content="Browse" Background="{DynamicResource DialogButtonBackgroundBrush}" Style="{StaticResource ActionBtn}" Height="34" Click="BrowseReportingMigrationFolderButton_Click"/>

                            <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Preview schema" Background="{DynamicResource DialogButtonBackgroundBrush}" Style="{StaticResource ActionBtn}" Width="130" Height="34" Margin="0,0,8,0" Click="PreviewReportingSchemaSqlButton_Click"/>
                                <Button Content="Install schema" Background="{DynamicResource DialogButtonBackgroundBrush}" Style="{StaticResource ActionBtn}" Width="130" Height="34" Margin="0,0,8,0" Click="InstallReportingSchemaButton_Click"/>
                                <Button Content="Preview SQL" Background="{DynamicResource DialogButtonBackgroundBrush}" Style="{StaticResource ActionBtn}" Width="120" Height="34" Margin="0,0,8,0" Click="PreviewReportingMigrationSqlButton_Click"/>
                                <Button Content="Execute SQL" Background="{DynamicResource DialogButtonBackgroundBrush}" Style="{StaticResource ActionBtn}" Width="120" Height="34" Margin="0,0,8,0" Click="ExecuteReportingMigrationSqlButton_Click"/>
                                <Button Content="Save SQL" Background="{DynamicResource DialogButtonBackgroundBrush}" Style="{StaticResource ActionBtn}" Width="120" Height="34" Click="SaveReportingMigrationSqlButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Save state..." Background="{DynamicResource DialogButtonBackgroundBrush}" Style="{StaticResource ActionBtn}" Width="120" Height="34" Margin="0,0,8,0" Click="SaveStateButton_Click"/>
                <Button Content="Load state..." Background="{DynamicResource DialogButtonBackgroundBrush}" Style="{StaticResource ActionBtn}" Width="120" Height="34" Margin="0,0,8,0" Click="LoadStateButton_Click"/>
                <Button Content="README" Background="{DynamicResource DialogButtonBackgroundBrush}" Style="{StaticResource ActionBtn}" Width="86" Height="34" Margin="0,0,8,0" Click="ReadmeButton_Click"/>
                <Button Content="Quick guide" Background="{DynamicResource DialogButtonBackgroundBrush}" Style="{StaticResource ActionBtn}" Width="106" Height="34" Click="QuickGuideButton_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="GenerateButton" Content="Generate" Background="#27AE60" Foreground="White" Style="{StaticResource ActionBtn}" Width="100" Height="34" Margin="0,0,8,0" Click="GenerateButton_Click"/>
                <Button Content="Close" Background="{DynamicResource DialogCancelButtonBackgroundBrush}" Style="{StaticResource ActionBtn}" Width="90" Height="34" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
