<Window x:Class="sp2rdlGenExtension.Dialogs.DatabaseConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Database connection"
        Width="720"
        MinWidth="640"
        Height="620"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#1E1E1E">

    <Window.Resources>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Database connection" Foreground="#D4D4D4" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Choose a connection found in the solution or enter SQL Server connection details."
                       Margin="0,6,0,0"
                       Foreground="#9AA0A6"
                       FontSize="12"/>
        </StackPanel>

        <Border Grid.Row="2" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Solution strings:" Style="{StaticResource InfoLabel}"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CmbDiscoveredConnections" DisplayMemberPath="DisplayName" Style="{StaticResource FieldCombo}" SelectionChanged="CmbDiscoveredConnections_SelectionChanged"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Source file:" Style="{StaticResource InfoLabel}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LblConnectionSource" Text="-" Foreground="#D4D4D4" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Server name:" Style="{StaticResource InfoLabel}"/>
                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4" x:Name="TxtServer" Style="{StaticResource FieldBox}" Height="34" TextChanged="ConnectionField_Changed"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Authentication:" Style="{StaticResource InfoLabel}"/>
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CmbAuthentication" Style="{StaticResource FieldCombo}" SelectionChanged="CmbAuthentication_SelectionChanged">
                    <ComboBoxItem Content="Windows Authentication" Tag="windows"/>
                    <ComboBoxItem Content="SQL Server Authentication" Tag="sql"/>
                </ComboBox>

                <CheckBox Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" x:Name="ChkTrustServerCertificate" Content="Trust server certificate" Foreground="#D4D4D4" VerticalAlignment="Center" Checked="ConnectionField_Changed" Unchecked="ConnectionField_Changed"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="User name:" Style="{StaticResource InfoLabel}"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtUser" Style="{StaticResource FieldBox}" Height="34" TextChanged="ConnectionField_Changed"/>

                <TextBlock Grid.Row="4" Grid.Column="3" Text="Password:" Style="{StaticResource InfoLabel}"/>
                <PasswordBox Grid.Row="4" Grid.Column="4" x:Name="TxtPassword" Background="#3C3C3C" Foreground="#D4D4D4" BorderBrush="#555555" BorderThickness="1" Padding="10,8" Height="34" PasswordChanged="TxtPassword_PasswordChanged"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Database:" Style="{StaticResource InfoLabel}"/>
                <ComboBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="4" x:Name="CmbDatabase" IsEditable="True" IsTextSearchEnabled="False" Style="{StaticResource FieldCombo}" SelectionChanged="CmbDatabase_SelectionChanged" DropDownOpened="CmbDatabase_DropDownOpened"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="Connection string:" Style="{StaticResource InfoLabel}"/>
                <TextBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="4" x:Name="TxtConnectionString" Style="{StaticResource FieldBox}" Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="TxtConnectionString_TextChanged"/>

                <TextBlock Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="4" x:Name="LblStatus" Text="" Foreground="#D7BA7D" FontSize="11" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="TestButton" Content="Test" Background="#3E3E42" Style="{StaticResource ActionBtn}" Width="90" Height="34" Margin="0,0,8,0" Click="TestButton_Click"/>
            <Button x:Name="OkButton" Content="Connect" Background="#27AE60" Style="{StaticResource ActionBtn}" Width="90" Height="34" Margin="0,0,8,0" Click="OkButton_Click"/>
            <Button Content="Cancel" Background="#4A4A4F" Style="{StaticResource ActionBtn}" Width="90" Height="34" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
