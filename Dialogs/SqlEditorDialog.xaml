<Window x:Class="sp2rdlGenExtension.Dialogs.SqlEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQL editor"
        Width="760"
        MinWidth="620"
        Height="520"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#1E1E1E">

    <Window.Resources>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TxtTitle" Text="SQL editor" Foreground="#D4D4D4" FontSize="18" FontWeight="Bold"/>
            <TextBlock x:Name="TxtHint" Text="" Foreground="#9AA0A6" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <TextBox Grid.Row="2"
                 x:Name="TxtSql"
                 Background="#111111"
                 Foreground="#D4D4D4"
                 CaretBrush="White"
                 BorderBrush="#3F3F46"
                 BorderThickness="1"
                 Padding="10"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas"
                 FontSize="13"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto"/>

        <DataGrid Grid.Row="4"
                  x:Name="GridPreview"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  Background="#F4F4F4"
                  Foreground="#000000"
                  RowBackground="#FFFFFF"
                  AlternatingRowBackground="#EEEEEE"
                  GridLinesVisibility="All"
                  HeadersVisibility="Column"/>

        <Grid Grid.Row="5" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="SuggestButton" Content="Suggest" Background="#3E3E42" Style="{StaticResource ActionBtn}" Width="90" Height="34" Margin="0,0,8,0" Click="SuggestButton_Click"/>
                <Button x:Name="TestButton" Content="Test" Background="#3E3E42" Style="{StaticResource ActionBtn}" Width="90" Height="34" Click="TestButton_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Background="#27AE60" Style="{StaticResource ActionBtn}" Width="90" Height="34" Margin="0,0,8,0" Click="OkButton_Click"/>
            <Button Content="Cancel" Background="#4A4A4F" Style="{StaticResource ActionBtn}" Width="90" Height="34" Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
